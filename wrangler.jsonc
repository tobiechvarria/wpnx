{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "wpnx",
	"main": "worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	}
}
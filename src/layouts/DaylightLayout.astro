---
import { ClientRouter } from 'astro:transitions';
import '../styles/daylight.css';

interface Props {
  title: string;
  description?: string;
  activePath: string;
}

const {
  title,
  description = 'WPNX 107.7 FM — a low-power FM community radio station in formation, broadcasting from Downtown Pensacola.',
  activePath,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/shows', label: 'Shows' },
  { href: '/participate', label: 'Participate' },
  { href: '/donate', label: 'Donate' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Source+Serif+4:ital,wght@0,300;0,400;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="daylight">
    <div class="dl__shell">
      <header class="dl-topbar">
        <nav class="dl-nav" aria-label="Main navigation">
          <a href="/" class="dl-nav__brand" aria-label="WPNX 107.7 FM — Home">
            <img src="/images/wpnx-logo-paper.svg" alt="WPNX 107.7 FM" class="dl-nav__logo" />
          </a>

          <button class="dl-nav__toggle" id="dlNavToggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="dlNavLinks">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>

          <ul class="dl-nav__links" id="dlNavLinks" role="list">
            {navLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  class:list={['dl-nav__link', { 'is-active': activePath === link.href }]}
                  aria-current={activePath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>

          <span class="dl-nav__status" id="dlNavStatus">
            <span class="dl-nav__dot" aria-hidden="true"></span>
            <span id="dlNavStatusText">Pre-Launch</span>
          </span>
        </nav>

        <div class="dl-player" id="dlPlayer" transition:persist="dl-player">
          <div class="dl-player__transport">
            <button class="dl-player__btn" id="dlPlayerBtn" aria-label="Play">
              <svg class="dl-player__icon dl-player__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z"/></svg>
              <svg class="dl-player__icon dl-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>

            <div class="dl-player__vol" id="dlPlayerVolWrap">
              <button class="dl-player__volbtn" id="dlPlayerVolBtn" aria-label="Volume" aria-expanded="false" aria-controls="dlPlayerVolPopover">
                <svg class="dl-player__icon dl-player__icon--vol-on" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 9v6h4l5 5V4L8 9H4z"/>
                  <path d="M15.3 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M17.8 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <svg class="dl-player__icon dl-player__icon--vol-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="display:none">
                  <path d="M4 9v6h4l5 5V4L8 9H4z"/>
                  <path d="M16 9l6 6M22 9l-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="dl-player__volpopover" id="dlPlayerVolPopover" role="group" aria-label="Volume level">
                <input
                  type="range"
                  class="dl-player__volslider"
                  id="dlPlayerVol"
                  min="0" max="1" step="0.05" value="0.8"
                  orient="vertical"
                  aria-label="Volume"
                  aria-orientation="vertical"
                />
              </div>
            </div>
          </div>

          <div class="dl-player__id">
            <span class="dl-player__freq">107.7</span>
            <span class="dl-player__live-tag">Live</span>
            <span class="dl-player__divider" aria-hidden="true"></span>
            <span class="dl-player__label" id="dlPlayerLabel">WPNX — Free Radio Pensacola</span>
          </div>

          <div class="dl-player__nowplaying" id="dlPlayerNowPlaying" hidden>
            <span class="dl-player__song" id="dlPlayerSong"></span>
            <span class="dl-player__artist" id="dlPlayerArtist"></span>
          </div>

          <audio id="dlPlayerAudio" preload="none" aria-label="WPNX 107.7 FM — live stream"></audio>
        </div>
      </header>

      <main class="dl-main">
        <slot />
      </main>

      <footer class="dl-footer">
        <div class="dl-footer__inner">
          <div>
            <p class="dl-footer__wordmark">WPNX 107.7 FM</p>
            <p class="dl-footer__sub">Free Radio Pensacola — Community Radio in Formation</p>
          </div>
          <nav aria-label="Footer navigation" class="dl-footer__nav">
            <ul role="list">
              {navLinks.map(link => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </nav>
          <div class="dl-footer__addr">
            <address>SCI Building, 220 West Garden St<br />Downtown Pensacola, FL</address>
            <p>© {new Date().getFullYear()} Free Radio Pensacola · Keep it free.</p>
          </div>
        </div>
      </footer>
    </div>


    <script>
      function initDaylightPage() {
        // ── Mobile nav toggle (nav itself is not persisted, rewired every page) ──
        const toggle = document.getElementById('dlNavToggle') as HTMLButtonElement | null;
        const links = document.getElementById('dlNavLinks') as HTMLUListElement | null;
        if (toggle && links && toggle.dataset.wired !== '1') {
          toggle.dataset.wired = '1';
          toggle.addEventListener('click', () => {
            const open = links.classList.toggle('is-open');
            toggle.setAttribute('aria-expanded', String(open));
          });
          links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
            links.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }));
        }

        // ── Now-playing poll — drives the nav badge (rewired each page-load,
        // since it isn't transition:persist'd) and the player's DJ name /
        // song+artist display (persisted, but harmless to re-query each
        // page-load: same DOM nodes throughout). One shared fetch/interval
        // for both, re-armed here with the previous page's interval cleared
        // first, rather than polling the same endpoint twice in parallel. ──
        const navStatusText = document.getElementById('dlNavStatusText') as HTMLElement | null;
        const playerLabel = document.getElementById('dlPlayerLabel') as HTMLElement | null;
        const nowPlayingBox = document.getElementById('dlPlayerNowPlaying') as HTMLElement | null;
        const songEl = document.getElementById('dlPlayerSong') as HTMLElement | null;
        const artistEl = document.getElementById('dlPlayerArtist') as HTMLElement | null;

        if (navStatusText || playerLabel) {
          const win = window as any;
          if (win.__dlNowPlayingInterval) clearInterval(win.__dlNowPlayingInterval);

          const updateNowPlaying = async () => {
            let data: any = null;
            try {
              const res = await fetch('/api/now-playing');
              data = await res.json();
            } catch {
              data = null;
            }

            const hasSong = !!(data?.live && data.artist && data.song);

            if (navStatusText) {
              navStatusText.textContent = !data?.live
                ? 'Pre-Launch'
                : hasSong ? `On Air · ${data.artist} — ${data.song}` : 'On Air';
            }
            if (playerLabel) {
              playerLabel.textContent = data?.dj || 'WPNX — Free Radio Pensacola';
            }
            if (nowPlayingBox && songEl && artistEl) {
              if (hasSong) {
                songEl.textContent = data.song;
                artistEl.textContent = data.artist;
                nowPlayingBox.hidden = false;
              } else {
                nowPlayingBox.hidden = true;
              }
            }
          };
          updateNowPlaying();
          win.__dlNowPlayingInterval = setInterval(updateNowPlaying, 45000);
        }

        // ── Persistent stream player — guarded so a persisted node is only wired once ──
        const audio = document.getElementById('dlPlayerAudio') as HTMLAudioElement | null;
        const btn = document.getElementById('dlPlayerBtn') as HTMLButtonElement | null;
        const volWrap = document.getElementById('dlPlayerVolWrap') as HTMLElement | null;
        const volBtn = document.getElementById('dlPlayerVolBtn') as HTMLButtonElement | null;
        const volPopover = document.getElementById('dlPlayerVolPopover') as HTMLElement | null;
        const volSlider = document.getElementById('dlPlayerVol') as HTMLInputElement | null;
        if (!audio || !btn || !volWrap || !volBtn || !volPopover || !volSlider) return;
        if (audio.dataset.wired === '1') return;
        audio.dataset.wired = '1';

        const iconPlay = btn.querySelector('.dl-player__icon--play') as HTMLElement;
        const iconPause = btn.querySelector('.dl-player__icon--pause') as HTMLElement;
        const iconVolOn = volBtn.querySelector('.dl-player__icon--vol-on') as HTMLElement;
        const iconVolOff = volBtn.querySelector('.dl-player__icon--vol-off') as HTMLElement;
        const SRC = '/api/stream';
        audio.volume = parseFloat(volSlider.value);

        function setPlaying(playing: boolean) {
          btn!.classList.toggle('is-playing', playing);
          iconPlay.style.display = playing ? 'none' : '';
          iconPause.style.display = playing ? '' : 'none';
          btn!.setAttribute('aria-label', playing ? 'Pause' : 'Play');
        }

        function reflectVolume() {
          const muted = audio.volume === 0;
          iconVolOn.style.display = muted ? 'none' : '';
          iconVolOff.style.display = muted ? '' : 'none';
        }

        function closeVolPopover() {
          volWrap!.classList.remove('is-open');
          volBtn!.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', () => {
          if (audio.paused) {
            // Re-set src on every play so a paused/reconnected listener always
            // rejoins at the live edge rather than resuming a stale buffer.
            audio.src = SRC;
            audio.play().catch(() => {
              if (playerLabel) playerLabel.textContent = 'Could not load stream';
            });
          } else {
            // Set UI state synchronously rather than waiting on the 'pause'
            // event, which fires asynchronously and was arriving too late
            // (or not at all) to reliably flip the button back to "play".
            // No need to clear src/load() here either: the play branch above
            // always re-sets audio.src on the next click regardless.
            setPlaying(false);
            audio.pause();
          }
        });
        audio.addEventListener('playing', () => setPlaying(true));
        audio.addEventListener('pause', () => setPlaying(false));
        audio.addEventListener('error', () => {
          if (playerLabel) playerLabel.textContent = 'Could not load stream';
          setPlaying(false);
        });

        volBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = volWrap!.classList.toggle('is-open');
          volBtn!.setAttribute('aria-expanded', String(open));
        });
        volSlider.addEventListener('input', () => {
          audio.volume = parseFloat(volSlider.value);
          reflectVolume();
        });
        // Popover is a lightweight click-to-reveal, not a modal: any click
        // elsewhere on the page (or navigating away) closes it.
        document.addEventListener('click', (e) => {
          if (!volWrap!.contains(e.target as Node)) closeVolPopover();
        });
        document.addEventListener('astro:before-swap', closeVolPopover);

        // Reflect current state in case this page-load is a transition back
        // to an already-playing persisted audio element.
        setPlaying(!audio.paused);
        reflectVolume();
      }

      // astro:page-load covers every view-transition navigation reliably.
      // It should also cover the very first load, but since this script is a
      // deferred module that can finish parsing after the router's own
      // initial dispatch, also run once immediately if the document is
      // already interactive/complete by the time we get here — initDaylightPage
      // is idempotent (guarded by data-wired) so a double call is harmless.
      document.addEventListener('astro:page-load', initDaylightPage);
      if (document.readyState !== 'loading') initDaylightPage();
      else document.addEventListener('DOMContentLoaded', initDaylightPage);
    </script>
  </body>
</html>

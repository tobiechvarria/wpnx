---
import DaylightLayout from '../layouts/DaylightLayout.astro';
import station from '../content/settings/station.json';

const rawShows = import.meta.glob('../content/shows/*.json', { eager: true, import: 'default' });
const showCount = Object.keys(rawShows).length;
---

<DaylightLayout title="WPNX 107.7 FM — Community Radio in Formation" activePath="/">
  <div class="dl-head">
    <p class="dl-head__a">WPNX<br />107.7</p>
    <p class="dl-head__b">ON-AIR<br />TARGET<br /><span style="color:var(--color-ink)">SEPT 2026</span></p>
  </div>

  <section class="dl-section">
    <p class="dl-section__title">{station.tagline}</p>
    <div class="hero-prose">
      {station.heroBody.split('\n\n').map((para: string) => <p>{para}</p>)}
    </div>
    <div class="dl-cta-row">
      <a href="/participate" class="dl-btn dl-btn--primary">Get Involved</a>
      <a href="/donate" class="dl-btn">Support the Station</a>
    </div>
  </section>

  <section class="dl-section">
    <p class="dl-section__title">STATION LOG</p>
    <div class="archive-table" role="table" aria-label="Station milestones">
      <div class="archive-row" role="row">
        <span class="archive-row__num" role="cell">2025</span>
        <span class="archive-row__main" role="cell">
          Transmitter secured
          <span class="archive-row__sub">{station.transmitterAddress.replace(/\n/g, ', ')}</span>
        </span>
        <span class="archive-row__status" role="cell">Done</span>
      </div>
      <div class="archive-row" role="row">
        <span class="archive-row__num" role="cell">2025</span>
        <span class="archive-row__main" role="cell">
          Shows announced
          <span class="archive-row__sub">First roster for on-air launch</span>
        </span>
        <span class="archive-row__status" role="cell">{showCount}</span>
      </div>
      <div class="archive-row archive-row--current" role="row">
        <span class="archive-row__num" role="cell">2026</span>
        <span class="archive-row__main" role="cell">
          On-air target
          <span class="archive-row__sub">First broadcast, Downtown Pensacola</span>
        </span>
        <span class="archive-row__status" role="cell"><span class="archive-dot" aria-hidden="true"></span>Sept 2026</span>
      </div>
    </div>
    <a href="/shows" class="dl-btn" style="margin-top:1.75rem;display:inline-block;">View All Shows →</a>
  </section>

  <style>
    .hero-prose p { line-height: 1.85; margin-bottom: 1.1em; max-width: 68ch; }
    .dl-cta-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  </style>
</DaylightLayout>

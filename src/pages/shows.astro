---
import DaylightLayout from '../layouts/DaylightLayout.astro';

const rawShows = import.meta.glob('../content/shows/*.json', { eager: true, import: 'default' });
const shows = Object.values(rawShows).sort(
  (a: any, b: any) => String(a.id).localeCompare(String(b.id))
);
---

<DaylightLayout title="Shows — WPNX 107.7 FM" activePath="/shows">
  <div class="dl-head">
    <p class="dl-head__a">SHOWS</p>
    <p class="dl-head__b">{shows.length} <span style="color:var(--color-ink)">ON DEMAND</span></p>
  </div>

  <section class="dl-section">
    <p class="dl-section__title">Programming from Radio Free Pensacola — the roster grows as WPNX grows.</p>

    <div class="show-grid">
      {shows.map((show: any) => {
        const hasAudio = Boolean(show.src);
        const mark = show.title.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || '??';
        return (
          <article class="show-card" data-src={show.src || ''}>
            <div class="show-card__art" aria-hidden="true">
              <span class="show-card__mark">{mark}</span>
            </div>

            <div class="show-card__body">
              <p class="show-card__title">{show.title}</p>
              {show.host && <p class="show-card__host">{show.host}</p>}
              <p class="show-card__episode">{show.episode_name}</p>
            </div>

            <div class="show-card__action">
              {hasAudio ? (
                <button class="show-card__btn" aria-label={`Play ${show.title} — ${show.episode_name}`} data-play-btn>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="show-card__icon show-card__icon--play"><path d="M8 5v14l11-7z"/></svg>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="show-card__icon show-card__icon--pause" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                  <span>Play episode</span>
                </button>
              ) : (
                <span class="show-card__badge">Coming Soon</span>
              )}
            </div>

            {hasAudio && (
              <div class="show-card__tray" data-tray aria-hidden="true">
                <span data-time>0:00</span>
                <div class="show-card__progress" data-progress-wrap><div class="show-card__fill" data-progress-fill></div></div>
                <span data-duration>--:--</span>
              </div>
            )}
          </article>
        );
      })}
    </div>

    <a href="/participate" class="dl-btn dl-btn--primary" style="margin-top:2rem;display:inline-block;">Submit a Show Proposal</a>
  </section>

  <style>
    .show-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 2px;
      background: var(--color-rule);
      border: 1px solid var(--color-rule);
    }

    .show-card {
      display: flex;
      flex-direction: column;
      background: var(--color-paper);
      position: relative;
    }

    .show-card__art {
      aspect-ratio: 1;
      background: var(--color-ink);
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: flex-end;
    }
    .show-card__mark {
      font-family: var(--f-display);
      color: var(--color-accent);
      font-size: clamp(3.5rem, 13cqi, 6rem);
      line-height: 0.78;
      letter-spacing: -0.01em;
      padding: 0 0.1em;
      transform: translateY(0.12em);
      transition: color 0.2s ease, transform 0.25s ease;
    }
    .show-card:hover .show-card__mark,
    .show-card:focus-within .show-card__mark { color: var(--color-paper); transform: translateY(0.12em) translateX(0.05em) scale(1.04); }

    .show-card__body { padding: 1rem 1.1rem 0.75rem; flex: 1; }
    .show-card__title {
      font-family: var(--f-display); font-size: 1.15rem; letter-spacing: 0.01em;
      line-height: 1.15; margin: 0 0 0.3rem;
    }
    .show-card__host {
      font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.04em;
      color: var(--color-accent-dark); margin: 0 0 0.5rem; text-transform: uppercase;
    }
    .show-card__episode {
      font-family: var(--f-mono); font-size: 0.68rem; color: var(--color-muted);
      line-height: 1.5; margin: 0;
    }

    .show-card__action { padding: 0 1.1rem 1.1rem; }
    .show-card__badge {
      font-family: var(--f-mono); font-size: 0.6rem; letter-spacing: 0.05em; text-transform: uppercase;
      color: var(--color-muted); border: 1px dashed var(--color-rule); padding: 0.3rem 0.6rem; display: inline-block;
    }
    .show-card__btn {
      display: flex; align-items: center; gap: 0.5rem; width: 100%;
      font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.05em; text-transform: uppercase;
      border: 1px solid var(--color-ink); background: transparent; color: var(--color-ink);
      padding: 0.5rem 0.75rem; cursor: pointer; transition: background 0.15s ease, color 0.15s ease;
    }
    .show-card__btn:hover, .show-card__btn:focus-visible, .show-card__btn.is-playing {
      background: var(--color-accent); border-color: var(--color-accent); color: #fff;
    }
    .show-card__icon { width: 12px; height: 12px; fill: currentColor; pointer-events: none; flex-shrink: 0; }

    .show-card__tray {
      display: none; align-items: center; gap: 0.6rem; padding: 0 1.1rem 1rem;
      font-family: var(--f-mono); font-size: 0.6rem; color: var(--color-muted);
    }
    .show-card__tray.is-open { display: flex; }
    .show-card__progress { flex: 1; height: 2px; background: var(--color-rule); cursor: pointer; }
    .show-card__fill { height: 100%; background: var(--color-accent); width: 0%; }

    .show-card__art { container-type: inline-size; }

    @media (max-width: 560px) {
      .show-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('.show-card').forEach((card) => {
        if (card.dataset.wired === '1') return;
        card.dataset.wired = '1';
        const src = card.dataset.src;
        if (!src) return;
        const btn = card.querySelector<HTMLButtonElement>('[data-play-btn]');
        const tray = card.querySelector<HTMLElement>('[data-tray]');
        const timeEl = card.querySelector<HTMLElement>('[data-time]');
        const durEl = card.querySelector<HTMLElement>('[data-duration]');
        const fillEl = card.querySelector<HTMLElement>('[data-progress-fill]');
        const progressWrap = card.querySelector<HTMLElement>('[data-progress-wrap]');
        const iconPlay = btn?.querySelector('.show-card__icon--play') as HTMLElement | null;
        const iconPause = btn?.querySelector('.show-card__icon--pause') as HTMLElement | null;
        if (!btn || !tray || !timeEl || !durEl || !fillEl) return;

        const audio = new Audio();
        audio.preload = 'none';
        function fmtTime(s: number): string {
          if (!isFinite(s)) return '--:--';
          const m = Math.floor(s / 60);
          const ss = Math.floor(s % 60).toString().padStart(2, '0');
          return `${m}:${ss}`;
        }
        const win = window as any;
        function stopActive(): void {
          if (win.__dlActiveAudio && win.__dlActiveAudio !== audio) {
            win.__dlActiveAudio.pause();
            win.__dlActiveCard?.querySelector('[data-play-btn]')?.classList.remove('is-playing');
            const p = win.__dlActiveCard?.querySelector('.show-card__icon--play') as HTMLElement | null;
            const pa = win.__dlActiveCard?.querySelector('.show-card__icon--pause') as HTMLElement | null;
            if (p) p.style.display = '';
            if (pa) pa.style.display = 'none';
            win.__dlActiveTray?.classList.remove('is-open');
          }
        }
        function setPlaying(playing: boolean): void {
          btn!.classList.toggle('is-playing', playing);
          if (iconPlay) iconPlay.style.display = playing ? 'none' : '';
          if (iconPause) iconPause.style.display = playing ? '' : 'none';
          const label = btn!.querySelector('span');
          if (label) label.textContent = playing ? 'Pause episode' : 'Play episode';
          tray!.classList.toggle('is-open', playing);
          tray!.setAttribute('aria-hidden', playing ? 'false' : 'true');
        }
        audio.addEventListener('loadedmetadata', () => { durEl!.textContent = fmtTime(audio.duration); });
        audio.addEventListener('timeupdate', () => {
          timeEl!.textContent = fmtTime(audio.currentTime);
          if (audio.duration) fillEl!.style.width = ((audio.currentTime / audio.duration) * 100).toFixed(2) + '%';
        });
        audio.addEventListener('ended', () => { setPlaying(false); win.__dlActiveAudio = null; win.__dlActiveCard = null; win.__dlActiveTray = null; });
        progressWrap?.addEventListener('click', (e: MouseEvent) => {
          if (!audio.duration) return;
          const rect = progressWrap.getBoundingClientRect();
          audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
        });
        btn.addEventListener('click', (e: Event) => {
          e.stopPropagation();
          const isThisPlaying = win.__dlActiveAudio === audio && !audio.paused;
          if (isThisPlaying) {
            audio.pause();
            setPlaying(false);
          } else {
            stopActive();
            if (!audio.src) audio.src = src;
            audio.play().catch(() => {});
            setPlaying(true);
            win.__dlActiveAudio = audio;
            win.__dlActiveCard = card;
            win.__dlActiveTray = tray;
          }
        });
      });
    });
  </script>
</DaylightLayout>
